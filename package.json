{
  "name": "zoo-keeper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "app": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:pi": "npm run build && electron-builder --linux AppImage --arm64",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist": "npm run build && electron-builder --linux AppImage --win portable"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "description": "Zoo Keeper: a 3D zoo simulator",
  "author": "Zoo Keeper",
  "main": "electron/main.cjs"
}
